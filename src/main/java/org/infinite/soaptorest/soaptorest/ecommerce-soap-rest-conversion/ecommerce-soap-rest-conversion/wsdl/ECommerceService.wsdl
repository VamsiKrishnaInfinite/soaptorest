  </wsdl:message>
  <wsdl:message name="GetProductResponse">
    <wsdl:part name="parameters" element="cat:GetProductResponse"/>
  </wsdl:message>

  <wsdl:message name="SearchProductsRequest">
    <wsdl:part name="parameters" element="cat:SearchProductsRequest"/>
  </wsdl:message>
  <wsdl:message name="SearchProductsResponse">
