  </wsdl:message>

  
  <wsdl:message name="PlaceOrderRequest">
    <wsdl:part name="parameters" element="ord:PlaceOrderRequest"/>
  </wsdl:message>
  <wsdl:message name="PlaceOrderResponse">
    <wsdl:part name="parameters" element="ord:PlaceOrderResponse"/>
