  ╚══════════════════════════════════════════════════════════════════╝
-->
<wsdl:definitions
    name="ECommerceService"
    targetNamespace="http://ecommerce.example.com/wsdl"

    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
    xmlns:tns="http://ecommerce.example.com/wsdl"
    xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy"
    xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
    xmlns:wsaw="http://www.w3.org/2006/05/addressing/wsdl"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"

    xmlns:cmn="http://ecommerce.example.com/types/common"
    xmlns:cust="http://ecommerce.example.com/types/customer"
    xmlns:cat="http://ecommerce.example.com/types/catalog"
    xmlns:ord="http://ecommerce.example.com/types/order"
    xmlns:inv="http://ecommerce.example.com/types/inventory">

  <!-- ============================================================ -->
  <!-- DOCUMENTATION                                               -->
  <!-- ============================================================ -->
  <wsdl:documentation>
    ECommerce Platform Web Service v3.0
    
    This service exposes SOAP operations for:
      1. CustomerService    – CRUD + search for customer accounts
      2. CatalogService     – product and category management
      3. OrderService       – order lifecycle from placement to return
      4. InventoryService   – stock levels, adjustments, purchase orders
      5. PromotionService   – coupon validation, promotion management

    Security: WS-Security UsernameToken (PasswordDigest) required on all
              operations except HealthCheck.
    Transport: HTTPS only.
    Encoding:  Document/Literal Wrapped.
  </wsdl:documentation>

  <!-- ============================================================ -->
  <!-- WS-POLICY (Security)                                        -->
  <!-- ============================================================ -->
  <wsp:Policy wsu:Id="UsernameTokenPolicy">
    <wsp:ExactlyOne>
      <wsp:All>
        <!-- Require WS-Security username token with password digest -->
        <wsp:Policy xmlns:sp="http://schemas.xmlsoap.org/ws/2005/07/securitypolicy">
          <sp:SupportingTokens>
            <wsp:Policy>
              <sp:UsernameToken
                sp:IncludeToken="http://schemas.xmlsoap.org/ws/2005/07/securitypolicy/IncludeToken/AlwaysToRecipient">
                <wsp:Policy>
                  <sp:WssUsernameToken10/>
                </wsp:Policy>
              </sp:UsernameToken>
            </wsp:Policy>
          </sp:SupportingTokens>
        </wsp:Policy>
      </wsp:All>
    </wsp:ExactlyOne>
  </wsp:Policy>

  <!-- ============================================================ -->
  <!-- TYPES — import all external XSD schemas                     -->
  <!-- ============================================================ -->
  <wsdl:types>
    <xs:schema>
      <xs:import namespace="http://ecommerce.example.com/types/common"
                 schemaLocation="xsd/common-types.xsd"/>
      <xs:import namespace="http://ecommerce.example.com/types/customer"
                 schemaLocation="xsd/customer-types.xsd"/>
      <xs:import namespace="http://ecommerce.example.com/types/catalog"
                 schemaLocation="xsd/catalog-types.xsd"/>
      <xs:import namespace="http://ecommerce.example.com/types/order"
                 schemaLocation="xsd/order-types.xsd"/>
      <xs:import namespace="http://ecommerce.example.com/types/inventory"
                 schemaLocation="xsd/inventory-types.xsd"/>
    </xs:schema>
  </wsdl:types>

  <!-- ============================================================ -->
  <!-- MESSAGES                                                    -->
  <!--   Document/Literal Wrapped: one part named "parameters"     -->
  <!--   pointing to the global element in the imported schema.    -->
  <!-- ============================================================ -->

  
  <wsdl:message name="CreateCustomerRequest">
    <wsdl:part name="parameters" element="cust:CreateCustomerRequest"/>
  </wsdl:message>
  <wsdl:message name="CreateCustomerResponse">
    <wsdl:part name="parameters" element="cust:CreateCustomerResponse"/>
  </wsdl:message>

  <wsdl:message name="GetCustomerRequest">
    <wsdl:part name="parameters" element="cust:GetCustomerRequest"/>
  </wsdl:message>
  <wsdl:message name="GetCustomerResponse">
    <wsdl:part name="parameters" element="cust:GetCustomerResponse"/>
  </wsdl:message>

  <wsdl:message name="UpdateCustomerRequest">
    <wsdl:part name="parameters" element="cust:UpdateCustomerRequest"/>
  </wsdl:message>
  <wsdl:message name="UpdateCustomerResponse">
    <wsdl:part name="parameters" element="cust:UpdateCustomerResponse"/>
  </wsdl:message>

  <wsdl:message name="SearchCustomersRequest">
    <wsdl:part name="parameters" element="cust:SearchCustomersRequest"/>
  </wsdl:message>
  <wsdl:message name="SearchCustomersResponse">
    <wsdl:part name="parameters" element="cust:SearchCustomersResponse"/>
  </wsdl:message>

  
  <wsdl:message name="CreateProductRequest">
    <wsdl:part name="parameters" element="cat:CreateProductRequest"/>
  </wsdl:message>
