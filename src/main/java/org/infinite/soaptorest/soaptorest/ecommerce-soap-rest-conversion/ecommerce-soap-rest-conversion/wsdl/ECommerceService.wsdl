  </wsdl:message>

  <!-- ============================================================ -->
  <!-- PORT TYPES (Abstract Interface)                             -->
  <!-- ============================================================ -->

  
  <wsdl:portType name="CustomerPortType">
    <wsdl:documentation>Operations for managing customer accounts.</wsdl:documentation>

    <wsdl:operation name="CreateCustomer">
      <wsdl:documentation>
        Registers a new customer account. Sends a verification email upon success.
        REST equivalent: POST /v1/customers
      </wsdl:documentation>
      <wsdl:input  message="tns:CreateCustomerRequest"  wsaw:Action="urn:CreateCustomer"/>
      <wsdl:output message="tns:CreateCustomerResponse" wsaw:Action="urn:CreateCustomerResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="GetCustomer">
      <wsdl:documentation>
        Retrieves a customer by ID.
        REST equivalent: GET /v1/customers/{customerId}
      </wsdl:documentation>
      <wsdl:input  message="tns:GetCustomerRequest"  wsaw:Action="urn:GetCustomer"/>
      <wsdl:output message="tns:GetCustomerResponse" wsaw:Action="urn:GetCustomerResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="UpdateCustomer">
      <wsdl:documentation>
        Partial update of a customer profile (patch semantics; null fields are ignored).
        REST equivalent: PATCH /v1/customers/{customerId}
      </wsdl:documentation>
      <wsdl:input  message="tns:UpdateCustomerRequest"  wsaw:Action="urn:UpdateCustomer"/>
      <wsdl:output message="tns:UpdateCustomerResponse" wsaw:Action="urn:UpdateCustomerResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="SearchCustomers">
      <wsdl:documentation>
        Paginated search across customer accounts.
        REST equivalent: GET /v1/customers?email=&amp;status=&amp;tier=&amp;page=&amp;size=
      </wsdl:documentation>
      <wsdl:input  message="tns:SearchCustomersRequest"  wsaw:Action="urn:SearchCustomers"/>
      <wsdl:output message="tns:SearchCustomersResponse" wsaw:Action="urn:SearchCustomersResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>
  </wsdl:portType>

  
  <wsdl:portType name="CatalogPortType">
    <wsdl:documentation>Operations for product catalog management.</wsdl:documentation>

    <wsdl:operation name="CreateProduct">
      <wsdl:documentation>
        Creates a new product with variants and pricing.
        REST equivalent: POST /v1/products
      </wsdl:documentation>
      <wsdl:input  message="tns:CreateProductRequest"  wsaw:Action="urn:CreateProduct"/>
      <wsdl:output message="tns:CreateProductResponse" wsaw:Action="urn:CreateProductResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="GetProduct">
      <wsdl:documentation>
        Retrieves a product by ID or URL slug.
        REST equivalent: GET /v1/products/{productId}
      </wsdl:documentation>
      <wsdl:input  message="tns:GetProductRequest"  wsaw:Action="urn:GetProduct"/>
      <wsdl:output message="tns:GetProductResponse" wsaw:Action="urn:GetProductResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="SearchProducts">
      <wsdl:documentation>
        Full-text and faceted product search with pagination.
        REST equivalent: GET /v1/products?keyword=&amp;categoryId=&amp;minPrice=&amp;maxPrice=&amp;page=
      </wsdl:documentation>
      <wsdl:input  message="tns:SearchProductsRequest"  wsaw:Action="urn:SearchProducts"/>
      <wsdl:output message="tns:SearchProductsResponse" wsaw:Action="urn:SearchProductsResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>
  </wsdl:portType>

  
  <wsdl:portType name="OrderPortType">
    <wsdl:documentation>Operations for order lifecycle management.</wsdl:documentation>

    <wsdl:operation name="PlaceOrder">
      <wsdl:documentation>
        Places an order from a cart. Triggers payment capture and inventory reservation.
        REST equivalent: POST /v1/orders
      </wsdl:documentation>
      <wsdl:input  message="tns:PlaceOrderRequest"  wsaw:Action="urn:PlaceOrder"/>
      <wsdl:output message="tns:PlaceOrderResponse" wsaw:Action="urn:PlaceOrderResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="GetOrder">
      <wsdl:documentation>
        Retrieves a single order by ID or order number.
        REST equivalent: GET /v1/orders/{orderId}
      </wsdl:documentation>
      <wsdl:input  message="tns:GetOrderRequest"  wsaw:Action="urn:GetOrder"/>
      <wsdl:output message="tns:GetOrderResponse" wsaw:Action="urn:GetOrderResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="SearchOrders">
      <wsdl:documentation>
        Paginated order search with multi-facet filters.
        REST equivalent: GET /v1/orders?customerId=&amp;status=&amp;from=&amp;to=&amp;page=
      </wsdl:documentation>
      <wsdl:input  message="tns:SearchOrdersRequest"  wsaw:Action="urn:SearchOrders"/>
      <wsdl:output message="tns:SearchOrdersResponse" wsaw:Action="urn:SearchOrdersResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="UpdateOrderStatus">
      <wsdl:documentation>
        Transitions an order to a new status; optionally notifies the customer.
        REST equivalent: PATCH /v1/orders/{orderId}/status
      </wsdl:documentation>
      <wsdl:input  message="tns:UpdateOrderStatusRequest"  wsaw:Action="urn:UpdateOrderStatus"/>
      <wsdl:output message="tns:UpdateOrderStatusResponse" wsaw:Action="urn:UpdateOrderStatusResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="CreateReturn">
      <wsdl:documentation>
        Initiates an RMA (Return Merchandise Authorisation) for one or more line items.
        REST equivalent: POST /v1/orders/{orderId}/returns
      </wsdl:documentation>
      <wsdl:input  message="tns:CreateReturnRequest"  wsaw:Action="urn:CreateReturn"/>
      <wsdl:output message="tns:CreateReturnResponse" wsaw:Action="urn:CreateReturnResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>
  </wsdl:portType>

  
  <wsdl:portType name="InventoryPortType">
    <wsdl:documentation>Operations for stock level queries and adjustments.</wsdl:documentation>

    <wsdl:operation name="GetInventoryLevel">
      <wsdl:documentation>
        Returns stock levels for a variant across one or all warehouses.
        REST equivalent: GET /v1/inventory?variantId=&amp;warehouseId=
      </wsdl:documentation>
      <wsdl:input  message="tns:GetInventoryLevelRequest"  wsaw:Action="urn:GetInventoryLevel"/>
      <wsdl:output message="tns:GetInventoryLevelResponse" wsaw:Action="urn:GetInventoryLevelResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="AdjustInventory">
      <wsdl:documentation>
        Applies a signed quantity delta to a variant's stock at a given warehouse.
        REST equivalent: POST /v1/inventory/adjustments
      </wsdl:documentation>
      <wsdl:input  message="tns:AdjustInventoryRequest"  wsaw:Action="urn:AdjustInventory"/>
      <wsdl:output message="tns:AdjustInventoryResponse" wsaw:Action="urn:AdjustInventoryResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>
  </wsdl:portType>

  
  <wsdl:portType name="PromotionPortType">
    <wsdl:documentation>Operations for coupon and promotion management.</wsdl:documentation>

    <wsdl:operation name="ValidateCoupon">
      <wsdl:documentation>
        Validates a coupon code against a customer's cart and computes the discount.
        REST equivalent: POST /v1/promotions/coupons/validate
      </wsdl:documentation>
      <wsdl:input  message="tns:ValidateCouponRequest"  wsaw:Action="urn:ValidateCoupon"/>
      <wsdl:output message="tns:ValidateCouponResponse" wsaw:Action="urn:ValidateCouponResponse"/>
      <wsdl:fault  name="ServiceFault" message="tns:ServiceFault"/>
    </wsdl:operation>
  </wsdl:portType>

